# Local development defaults. SQLite needs no setup and is the only backend
# that has actually been exercised; the Postgres line is provided for reference.
DATABASE_URL=sqlite:///./loan_verification.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/loan_verification

JWT_SECRET_KEY=replace-with-a-local-development-secret

# Required only for AI recommendations. Without it the app runs and that one
# endpoint fails closed.
GROQ_API_KEY=

# Browser origins allowed to call the API (the frontend is served separately).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create tables and seed the three role users on startup.
AUTO_INIT_DB=true
